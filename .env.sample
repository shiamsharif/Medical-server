NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
MONGODB_URI=your_mongodb_connection_string
MONGODB_DATABASE=medicare_connect
BETTER_AUTH_SECRET=your_better_auth_secret_at_least_32_characters
# Auth is exposed through the frontend /api proxy so OAuth cookies stay first-party.
BETTER_AUTH_URL=http://localhost:3000
# Optional Google OAuth (set both values together)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# Use keys from the same Stripe sandbox. Never expose either value in the browser.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
EMAIL_FROM=your_verified_sender_email
RESEND_API_KEY=your_resend_api_key
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
CRON_SECRET=your_secure_cron_secret
